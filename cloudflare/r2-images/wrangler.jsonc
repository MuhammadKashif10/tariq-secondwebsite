{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // LOCAL TESTING ONLY. In production the site loads photos from the bucket's
  // public r2.dev URL; this Worker is never deployed. `npm run local-r2` runs it
  // against the simulated bucket filled by `npm run upload:local`, standing in
  // for r2.dev so the whole flow can be tested before the real bucket exists.
  "name": "dubai-junk-images-local",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  "workers_dev": false,
  "preview_urls": false,

  "r2_buckets": [
    {
      "binding": "IMAGES",
      // Must match R2_BUCKET used by scripts/upload-images.mjs.
      "bucket_name": "dubai-junk-images"
    }
  ],

  "vars": {
    // Filenames are not content-hashed, so keep this moderate. next/image
    // caches its resized copies for 31 days on top of this.
    "CACHE_CONTROL": "public, max-age=604800, stale-while-revalidate=86400"
  },

  "observability": { "enabled": true }
}
