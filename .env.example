# Copy to .env.local for local development. Never commit real values.

# ── Next.js app (local .env.local AND Vercel: Production + Preview) ──────────
# Base URL of the Cloudflare image origin. Leave empty to serve photos from
# /public exactly as before (this is also the rollback).
# Production: the bucket's public URL, e.g. https://pub-<id>.r2.dev
NEXT_PUBLIC_IMAGE_CDN_URL=https://pub-43cad28dc6cb46bf8df224205cbc5782.r2.dev

# Set to 1 only after production is verified AND local /public/images copies
# are removed. Sends old /images/* URLs to the CDN with a 301.
IMAGE_REDIRECT_LOCAL_TO_CDN=

# ── Local testing only. NEVER set on Vercel. ───────────────────────────────
# Lets next/image fetch from the local r2.dev stand-in (npm run local-r2).
IMAGE_CDN_ALLOW_LOCAL_IP=

# ── Uploading to R2 (your machine only, NEVER on Vercel) ───────────────────
# Used by cloudflare/r2-images/scripts/upload-images.mjs --remote.
# Alternatively run `npx wrangler login` once instead of setting these.
# Token permission: Account > Workers R2 Storage > Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=dubai-junk-images
# S3-compatible keys for the same bucket (alternative to the API token)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket's public r2.dev URL. Used by upload --changed-only and verify.
IMAGE_CDN_URL=
